# Hugo build output
public/
# 驗證用的暫時 build 目錄。注意 hugo 的 --destination 相對路徑是相對於
# --source 而非當前工作目錄，在 repo 外下指令仍可能把輸出寫進這裡。
hugotest/

# Hugo cache
.hugo_build.lock
resources/

# mdtools build output (Go binary; see scripts/mdtools/README.md)
bin/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Temporary files
*.tmp
*.swp

# Local convenience symlink for serving /blog/ subpath on localhost
/blog

# Claude Code runtime lock (ScheduleWakeup / scheduled tasks)
.claude/scheduled_tasks.lock

# Playwright MCP runtime cache (snapshots, console logs)
.playwright-mcp/

# Playwright test artifacts
node_modules/
.test-www/
test-results/
playwright-report/
playwright/.cache/

# RAG / MCP demo build artifacts (regenerable)
scripts/rag-demo/index.pkl
scripts/rag-demo/__pycache__/
scripts/mcp-demo/__pycache__/

# blogsearch index (regenerable via `blogsearch ingest`)
.blogsearch/

# 編輯器 markdown 預覽暫存檔（Notepad++ 等）
.npp-md-preview.html
*-md-preview.html

# skill-sync 本機同步記帳檔（.claude/skills/<name>/ 下），不入版控：
# .skill-sync-base 記錄上次 pull/push 的內容雜湊（方向判定用），
# .skill-sync-override 宣告本地內容為刻意客製，兩者皆為單機 bookkeeping。
.claude/skills/*/.skill-sync-base
.claude/skills/*/.skill-sync-override

# skill-sync 的執行產物（uv 建的虛擬環境與快取），不入版控：
# 只有 SKILL.md / pyproject.toml / uv.lock / skill_sync/ / tests/ 是來源
.claude/skills/*/.venv/
.claude/skills/*/.pytest_cache/
.claude/skills/*/.ruff_cache/
.claude/skills/*/__pycache__/
.claude/skills/**/__pycache__/

# skill-sync 的 --force 追溯紀錄，不入版控：
# 繞過可攜性閘門時把違規清單落地在這裡，供事後追查是誰在什麼時候推了什麼。
# 它是單機紀錄而非共用內容——skill-sync 自己的 EXCLUDE_DIRS 也把 hook-logs/
# 排除在同步之外，這裡只是讓 repo 跟上同一個認定。
.claude/hook-logs/
# 需要第二條的理由：那個預設路徑是相對的，而 skill-sync 的 shim 用
# `uv run --directory <skill_dir>` 執行，cwd 是 skill 目錄不是 repo 根，
# 所以 log 實際落在 .claude/skills/<name>/.claude/hook-logs/ 而非上面那個位置。
.claude/skills/*/.claude/hook-logs/
