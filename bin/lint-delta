#!/usr/bin/env python3
"""只回報這次改動新增的 mdtools lint 問題，把既有的分開計數。

用途：AGENTS.md〈提交〉的 lint 那一步。全量 lint（`bin/mdtools lint content/`）只用來看
歷史基線；這次的品質看這支的輸出。

用法：bin/lint-delta [--renames <檔案>] <這次的檔案...>
  路徑以執行時的目錄起算。--renames 的檔案每行是「舊路徑<TAB>新路徑」（路徑以 repo 根目錄起算），
  `bin/content-move --renames` 寫出的就是這個格式；同一個檔案搬了兩次（A→B、B→C）時，C 配對到 A。
  不是 `content/` 底下的 `.md` 的檔案、以及這次刪除的檔案，印一行
  `skip` 並跳過，所以可以把這次的檔案整組交給它。

行為：
- 對每個檔案各 lint 兩次：工作樹的版本，以及 HEAD 的版本。HEAD 版放在暫存目錄裡的同一個
  相對路徑再 lint，因為 mdtools 依路徑套用不同的規則（卡片目錄的 frontmatter 規則比一般
  文章嚴，同一份內容放在 `content/report/` 是 error、放在別處是 warn）。
- 比對鍵是「嚴重度、規則 ID、訊息、那一行的內容」，不含行號（前面插入一行，後面每一行的
  行號都會變）。訊息要在鍵裡：frontmatter 類的問題一律報在第 1 行，那一行的內容都是
  `---`，只用規則 ID 加行內容的話，「HEAD 缺 title、這次又缺 description」會被判成既有。
- 新檔（不在 HEAD）的 lint 結果全部算新增。staged 的改名（`git mv`）拿舊路徑的 HEAD 版本比對；
  沒有 staged 的改名在 git 看來是刪除加新檔，lint 結果全部算新增，先 `git mv` 或 `git add` 再跑。
  git 只把內容相似度 50% 以上的配對成改名，連結改寫多的短檔 staged 了也配對不到；這種改名用
  --renames 給配對，它優先於 git 的偵測。
- 新增的問題照 mdtools 的格式印到 stdout；stderr 結尾一定印
  `lint-delta: N new (E error), M existing, K file(s) linted, S skipped`，K 加 S 要等於給的檔案數。

exit：0 沒有新增的 error（可以有新增的 warn）；1 有新增的 error；2 用法錯誤、mdtools 不存在、--renames 的
檔案不存在或有一行不是「舊路徑<TAB>新路徑」。

測試：python3 -m unittest discover -s bin/tests
"""

import collections
import os
import re
import shutil
import subprocess
import sys
import tempfile

LINE = re.compile(r"^(?P<path>[^:]+):(?P<line>\d+): \[(?P<sev>\w+)\] (?P<rule>\S+) (?P<msg>.*)$")


def lint(mdtools, cwd, relpath):
    r = subprocess.run([mdtools, "lint", relpath], capture_output=True, text=True, cwd=cwd)
    with open(os.path.join(cwd, relpath), encoding="utf-8") as f:
        lines = f.read().split("\n")
    out = []
    for raw in r.stdout.split("\n"):
        m = LINE.match(raw)
        if not m:
            continue
        n = int(m["line"])
        content = lines[n - 1] if 0 < n <= len(lines) else ""
        out.append(((m["sev"], m["rule"], m["msg"], content), raw))
    return out


def renames(root):
    """回傳 {新路徑: 舊路徑}，取自 `git diff -M --name-status -z HEAD`（staged 的改名才偵測得到）。"""
    out = subprocess.run(["git", "diff", "-M", "--name-status", "-z", "HEAD"], capture_output=True, text=True, cwd=root).stdout
    parts = out.split("\0")
    result = {}
    i = 0
    while i < len(parts) and parts[i]:
        status = parts[i]
        if status.startswith("R") or status.startswith("C"):
            result[parts[i + 2]] = parts[i + 1]
            i += 3
        else:
            i += 2
    return result


def load_renames(path):
    """讀「舊路徑<TAB>新路徑」，回傳 {新路徑: 最初的舊路徑}；依檔案裡的順序接起連續的搬移。"""
    if not os.path.isfile(path):
        sys.stderr.write(f"lint-delta: 找不到 --renames 的檔案：{path}\n")
        sys.exit(2)
    result = {}
    with open(path, encoding="utf-8") as f:
        for n, raw in enumerate(f, 1):
            line = raw.rstrip("\n")
            if not line:
                continue
            parts = line.split("\t")
            if len(parts) != 2:
                sys.stderr.write(f"lint-delta: {path} 第 {n} 行不是「舊路徑<TAB>新路徑」\n")
                sys.exit(2)
            old, new = parts
            result[new] = result.pop(old, old)
    return result


def main():
    args = sys.argv[1:]
    rename_file = None
    if args[:1] == ["--renames"]:
        if len(args) < 2:
            sys.stderr.write(__doc__)
            sys.exit(2)
        rename_file, args = args[1], args[2:]
    if not args or args[0] in ("-h", "--help"):
        sys.stderr.write(__doc__)
        sys.exit(2)
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if top.returncode != 0:
        sys.stderr.write("lint-delta: 不在 git repo 裡\n")
        sys.exit(2)
    root = top.stdout.strip()
    mdtools = os.path.join(root, "bin", "mdtools")
    if not os.access(mdtools, os.X_OK):
        sys.stderr.write("lint-delta: 找不到 bin/mdtools（在 scripts/mdtools 跑 go build -o ../../bin/mdtools .）\n")
        sys.exit(2)

    paths = [os.path.relpath(os.path.abspath(p), root) for p in args]
    moved = renames(root)
    if rename_file:
        moved.update(load_renames(rename_file))
    new_total = new_err = existing = skipped = 0
    tmp = tempfile.mkdtemp(prefix="lint-delta-")
    try:
        for rel in paths:
            if not (rel.startswith("content/") and rel.endswith(".md")):
                sys.stderr.write(f"lint-delta: skip {rel}（不是 content/ 底下的 .md，lint 不管它）\n")
                skipped += 1
                continue
            if not os.path.isfile(os.path.join(root, rel)):
                in_head = subprocess.run(["git", "cat-file", "-e", f"HEAD:{rel}"], cwd=root).returncode == 0
                if in_head:
                    sys.stderr.write(f"lint-delta: skip {rel}（這次刪除的檔案）\n")
                    skipped += 1
                    continue
                sys.stderr.write(f"lint-delta: {rel} 不在工作樹也不在 HEAD\n")
                sys.exit(2)
            now = lint(mdtools, root, rel)
            source = moved.get(rel, rel)  # 改名的檔案拿舊路徑的 HEAD 版本，放在新路徑 lint
            head = subprocess.run(["git", "show", f"HEAD:{source}"], capture_output=True, cwd=root)
            before = collections.Counter()
            if head.returncode == 0:
                dest = os.path.join(tmp, rel)
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                with open(dest, "wb") as f:
                    f.write(head.stdout)
                before = collections.Counter(k for k, _ in lint(mdtools, tmp, rel))
            for key, raw in now:
                if before[key] > 0:
                    before[key] -= 1
                    existing += 1
                else:
                    new_total += 1
                    if key[0] == "error":
                        new_err += 1
                    print(raw)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    sys.stderr.write(
        f"lint-delta: {new_total} new ({new_err} error), {existing} existing, "
        f"{len(paths) - skipped} file(s) linted, {skipped} skipped\n"
    )
    sys.exit(1 if new_err else 0)


if __name__ == "__main__":
    main()
