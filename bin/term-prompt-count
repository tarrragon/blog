#!/usr/bin/env python3
"""派術語探針之前，數每個測試詞在 subagent 的系統提示來源裡出現的行數。

用途：CLAUDE.md〈術語探針與系統提示〉。在本 repo 底下派出的 subagent，系統提示裡已經有規則檔、
memory 索引、skill 的說明與最近的 commit 標題；測試詞寫在其中任何一處時，探針回報「有把握」可能
只是複述了那份定義。

用法：bin/term-prompt-count <詞...>
  在 repo 裡任何目錄執行都可以（以 repo 根目錄為準）。含空白的詞加引號（'test oracle'），
  不然會被拆成兩個詞各數一次。英文不分大小寫。

數的來源（每個詞各數一次，印出非零的來源與合計）：
- repo 根目錄的 AGENTS.md、CLAUDE.md 與 docs/rules/*.md
- ~/.claude/CLAUDE.md
- memory 索引 ~/.claude/projects/<repo 根目錄的絕對路徑，每個非英數字元換成 -> /memory/MEMORY.md
- .claude/skills 與 ~/.claude/skills 底下每一份 SKILL.md（遞迴；跳過 .trash/，那是刪掉的 skill，
  不在系統提示裡）。數的是整份 SKILL.md，範圍比系統提示裡的 description 寬。
- `git log -20 --format=%s` 的 commit 標題
數的是含這個詞的行數，不是出現次數；判斷「是不是零」時兩者沒有差別。
plugin 的 skill、agent 類型與 MCP server 的說明沒有固定的檔案位置，這支工具數不到；輸出的最後
一行會提醒（要怎麼處理寫在 CLAUDE.md）。

為什麼寫成工具：手打的 grep 在 zsh 裡碰到沒有匹配的 glob（`~/.claude/skills/*/SKILL.md`）會讓整條
指令不執行，專案自己的 skill 也一起被算成 0；`grep -c` 對多個檔案的輸出又要人工加總。

兩份 CLAUDE.md、AGENTS.md、MEMORY.md，以及 docs/rules/ 與 .claude/skills/ 的檔案（一份都沒有時），
是一定應該讀得到的固定來源，讀不到的每一份在 stderr 印 `term-prompt-count: 讀不到固定來源 <路徑>`：
少一份來源時 M 只少 1，不印出來就看不出來。
結尾在 stderr 印 `term-prompt-count: N term(s), M file(s) scanned`。M 是 0、或 stderr 有「讀不到
固定來源」時，那一次的 0 行不能當成「系統提示裡沒有」。

exit：0 完成；1 有讀不到的固定來源（計數照樣印出，但 0 行不能採用）；2 用法錯誤或不在 git repo 裡。

測試：python3 -m unittest discover -s bin/tests
"""

import glob
import os
import re
import subprocess
import sys


def die(msg):
    sys.stderr.write(f"term-prompt-count: {msg}\n")
    sys.exit(2)


def fixed_sources(root):
    """一定應該讀得到的來源；讀不到時要在 stderr 列出來，不然檔案集少一份也看不出來。

    memory 目錄名是 Claude Code 把 repo 根目錄的絕對路徑裡每一個非英數字元換成 `-` 的結果
    （`/` 是，`_`、`.` 也是：`.claude/worktrees/` 底下的 worktree 會變成 `--claude-worktrees-`）。
    """
    home = os.path.expanduser("~")
    return [
        os.path.join(root, "AGENTS.md"),
        os.path.join(root, "CLAUDE.md"),
        os.path.join(home, ".claude", "CLAUDE.md"),
        os.path.join(home, ".claude", "projects", re.sub(r"[^A-Za-z0-9]", "-", root), "memory", "MEMORY.md"),
    ]


def sources(root):
    """(來源名稱, 文字行) 的清單，與讀不到的固定來源。"""
    home = os.path.expanduser("~")
    fixed = fixed_sources(root)
    files = fixed[:2] + sorted(glob.glob(os.path.join(root, "docs", "rules", "*.md"))) + fixed[2:]
    for base in (os.path.join(root, ".claude", "skills"), os.path.join(home, ".claude", "skills")):
        for dirpath, dirnames, filenames in os.walk(base):
            dirnames[:] = sorted(d for d in dirnames if d != ".trash")
            if "SKILL.md" in filenames:
                files.append(os.path.join(dirpath, "SKILL.md"))
    out = []
    for f in files:
        if os.path.isfile(f):
            with open(f, encoding="utf-8", errors="replace") as fh:
                out.append((f, fh.read().splitlines()))
    log = subprocess.run(["git", "log", "-20", "--format=%s"], capture_output=True, text=True, cwd=root)
    out.append(("git log -20 的 commit 標題", log.stdout.splitlines()))
    return out, [f for f in fixed if not os.path.isfile(f)]


def main():
    terms = sys.argv[1:]
    if not terms or any(t.startswith("-") for t in terms):
        die("用法：bin/term-prompt-count <詞...>")
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if top.returncode != 0:
        die("不在 git repo 裡")
    root = top.stdout.strip()
    srcs, missing = sources(root)
    home = os.path.expanduser("~")
    for f in missing:
        sys.stderr.write(f"term-prompt-count: 讀不到固定來源 {f}\n")
    rules = sum(1 for name, _ in srcs if os.sep + os.path.join("docs", "rules") + os.sep in name)
    skills = sum(1 for name, _ in srcs if name.startswith(os.path.join(root, ".claude", "skills") + os.sep))
    for label, count in (("docs/rules/*.md", rules), (".claude/skills/**/SKILL.md", skills)):
        if not count:
            missing.append(label)
            sys.stderr.write(f"term-prompt-count: 讀不到固定來源 {label}（一份都沒有）\n")
    for term in terms:
        key = term.lower()  # 英文不分大小寫：Test Oracle 與 test oracle 是同一個詞
        hits = [(name, sum(key in line.lower() for line in lines)) for name, lines in srcs]
        hits = [(n, c) for n, c in hits if c]
        total = sum(c for _, c in hits)
        print(f"{term}：{total} 行")
        for name, c in hits:
            shown = os.path.relpath(name, root) if name.startswith(root + os.sep) else name.replace(home, "~", 1)
            print(f"  {c}  {shown}")
    print("plugin 的 skill、agent 類型與 MCP server 的說明不在上面：讀這一次系統提示裡的清單人工確認")
    sys.stderr.write(f"term-prompt-count: {len(terms)} term(s), {len(srcs) - 1} file(s) scanned\n")
    sys.exit(1 if missing else 0)


if __name__ == "__main__":
    main()
