#!/usr/bin/env bash
set -euo pipefail

# skill-mirror: 把 .claude/skills/<name>/ 同步到 content/skills/<name>/
#   SKILL.md                → skill.md（產生 Hugo frontmatter）
#   references/<ref>.md     → <ref>.md（保留鏡像既有的 frontmatter，只換 body）
# 自動處理：H1→H2、principles/ → /report/ 連結轉換、平輩 reference → /skills/<name>/ route
#
# reference 只同步「鏡像已經存在」的那些——建立新鏡像是刻意的動作、要先手動建檔
# 並寫好 frontmatter（title / date / description / tags），本工具不代為決定那些欄位。

usage() {
  echo "Usage: skill-mirror <skill-name>"
  echo ""
  echo "Example: skill-mirror compositional-writing"
  echo ""
  echo "Reads .claude/skills/<name>/SKILL.md and writes content/skills/<name>/skill.md"
  echo "with Hugo frontmatter and /report/ links (replacing references/principles/)."
  echo ""
  echo "Also syncs references/<ref>.md into content/skills/<name>/<ref>.md for every"
  echo "reference that already has a mirror. Creating a new mirror is a deliberate act:"
  echo "make the file and write its frontmatter first, then this tool keeps it in sync."
  exit 1
}

[[ $# -lt 1 ]] && usage

SKILL_NAME="$1"
SOURCE=".claude/skills/${SKILL_NAME}/SKILL.md"
TARGET_DIR="content/skills/${SKILL_NAME}"
TARGET="${TARGET_DIR}/skill.md"

[[ ! -f "$SOURCE" ]] && echo "Error: $SOURCE not found" && exit 1
[[ ! -d "$TARGET_DIR" ]] && echo "Error: $TARGET_DIR not found (create it first)" && exit 1

# --- Step 1: 從 SKILL.md 提取 metadata ---
# 版號的權威是 frontmatter 的 metadata.version。
# 版本紀錄搬到同目錄的 CHANGELOG.md 之後，SKILL.md 裡不再有可推導的版號——
# 先前那個「全檔取最大三段數字」的推導本來就會被引用別 skill 的裸版號污染（發生過兩次）。
skill_version=$(sed -n '/^  version:/{s/^  version: *//;s/"//g;p;q;}' "$SOURCE")
if [[ -z "$skill_version" ]]; then
  echo "Error: $SOURCE 的 frontmatter 沒有 metadata.version" >&2
  exit 1
fi

# CHANGELOG.md 存在時比對它最上面那一條，兩個住址不一致就是漏更新。
CHANGELOG_PATH=".claude/skills/${SKILL_NAME}/CHANGELOG.md"
if [[ -f "$CHANGELOG_PATH" ]]; then
  latest_logged=$(grep -m1 -oE '^\*\*Version\*\*: [0-9]+\.[0-9]+\.[0-9]+' "$CHANGELOG_PATH" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
  if [[ -n "$latest_logged" && "$latest_logged" != "$skill_version" ]]; then
    echo "Error: frontmatter metadata.version ($skill_version) 與 CHANGELOG.md 最新一條 ($latest_logged) 不一致" >&2
    echo "  版號有兩個住址，兩個都要改。" >&2
    exit 1
  fi
fi

skill_title=$(grep -m1 '^# ' "$SOURCE" | sed 's/^# //')
skill_date=$(date +%Y-%m-%d)

# 如果已有 target，保留原本的 date
if [[ -f "$TARGET" ]]; then
  existing_date=$(grep -m1 '^date:' "$TARGET" | sed 's/date: *//' | tr -d '"')
  [[ -n "$existing_date" ]] && skill_date="$existing_date"
fi

echo "Mirroring: $SOURCE → $TARGET"
echo "  title: $skill_title"
echo "  version: $skill_version"
echo "  date: $skill_date"

# --- Step 2: 建立 report slug 清單 ---
REPORT_LIST=$(ls content/report/*.md 2>/dev/null | sed 's|content/report/||;s|\.md||' | grep -v _index)

# 查找 report slug 的函式
find_report_slug() {
  local principle="$1"
  # 精確匹配
  if echo "$REPORT_LIST" | grep -qx "$principle"; then
    echo "/report/${principle}/"
    return 0
  fi
  # 已知的不同名對應
  case "$principle" in
    teaching-prose-neutral-register)
      echo "/report/teaching-register-states-not-addresses-reader/" ;;
    cross-expertise-scenario-not-analogy)
      echo "/report/cross-expertise-communication-scenario-not-analogy/" ;;
    management-reportable-info-in-technical-content)
      echo "/report/technical-content-needs-management-reportable-info/" ;;
    multi-pass-review-frame-granularity)
      echo "/report/multi-pass-review-frame-granularity-blindspot/" ;;
    cadence-homogenization)
      echo "/report/cadence-homogenization-in-batch-writing/" ;;
    decorative-symbols-keyword-bank)
      echo "/report/visual-tool-error-layer-alignment/" ;;
    keyword-list-needs-dominant-violating-sense)
      echo "/report/keyword-list-needs-dominant-violating-sense/" ;;
    keyword-pattern-does-not-transfer-across-genres)
      echo "/report/keyword-pattern-does-not-transfer-across-genres/" ;;
    recompute-trigger-must-bind-to-the-changing-event)
      echo "/report/recompute-trigger-must-bind-to-the-changing-event/" ;;
    teaching-article-context)
      echo "/record/teaching-article-context-method/" ;;
    term-probe-measures-register-not-invention)
      echo "/report/term-probe-measures-register-not-invention/" ;;
    probe-independence-is-not-transferable)
      echo "/report/probe-independence-is-not-transferable/" ;;
    risk-asymmetric-audit-standard)
      echo "/report/security-teaching-rigor-asymmetry/" ;;
    *)
      return 1 ;;
  esac
}

# --- Step 3: 轉換 ---
tmpfile=$(mktemp)

# 寫 Hugo frontmatter
cat > "$tmpfile" <<FRONTMATTER
---
title: "${skill_title}"
date: ${skill_date}
description: "$(grep -m1 'description:' "$SOURCE" | sed 's/.*description: *"//;s/"$//' | cut -c1-100)"
tags: ["skill", "writing", "methodology"]
name: ${SKILL_NAME}
license: MIT
metadata:
  version: ${skill_version}
  category: writing-methodology
---
FRONTMATTER

# 處理 body
skip_frontmatter=true
frontmatter_count=0
while IFS= read -r line; do
  # 跳過原始 frontmatter
  if [[ "$line" == "---" ]]; then
    frontmatter_count=$((frontmatter_count + 1))
    if [[ $frontmatter_count -le 2 ]]; then
      continue
    fi
  fi
  [[ $frontmatter_count -lt 2 ]] && continue

  # H1 → H2
  if [[ "$line" =~ ^'# '[^#] ]]; then
    line="#${line}"
  fi

  # 替換 references/principles/xxx.md → /report/slug/
  if echo "$line" | grep -q 'references/principles/'; then
    # 提取所有 principle slug
    for slug in $(echo "$line" | grep -oE 'references/principles/[a-z0-9_-]+\.md' | sed 's|references/principles/||;s|\.md||'); do
      report_path=$(find_report_slug "$slug" 2>/dev/null) || true
      if [[ -n "$report_path" ]]; then
        line="${line//references\/principles\/${slug}.md/${report_path}}"
      else
        echo "  WARN: no report card for ${slug} — leaving as-is" >&2
      fi
    done
  fi

  # 替換一般 references/xxx.md → /skills/<name>/xxx/
  # principles/ 已在上一段消化完，這裡剩下的是平輩 reference。鏡像把它們攤平成
  # content/skills/<name>/xxx.md（沒有 references/ 這層），相對路徑照抄過去會是
  # broken link — mdtools cards 會判 error 擋下 CI。漏掉這段的症狀是重新鏡像時
  # 靜默退化：舊鏡像手改過的 Hugo route 被原始相對路徑蓋回去。
  if echo "$line" | grep -qE '\]\(references/[a-z0-9_-]+\.md\)'; then
    for ref in $(echo "$line" | grep -oE 'references/[a-z0-9_-]+\.md' | sed 's|references/||;s|\.md||'); do
      if [[ -f "${TARGET_DIR}/${ref}.md" ]]; then
        line="${line//references\/${ref}.md//skills/${SKILL_NAME}/${ref}/}"
      else
        echo "  WARN: no mirror for reference ${ref} — leaving as-is" >&2
      fi
    done
  fi

  echo "$line"
done < "$SOURCE" >> "$tmpfile"

mv "$tmpfile" "$TARGET"

# 自動跑 fmt
if command -v ./bin/mdtools &>/dev/null; then
  ./bin/mdtools fmt --fix "$TARGET" 2>/dev/null && echo "  fmt applied"
fi

# --- Step 4: 同步 references/ ---
# 只處理鏡像已存在的 reference。缺同步機制時這一層會靜默漂移——鏡像落後把源檔的
# 違規擋在 lint 之外（.claude/skills/ 在 pre-commit 跳過 lint），兩個 surface 因此
# 可以分岔到結構層而沒有人發現。
REF_DIR=".claude/skills/${SKILL_NAME}/references"
ref_synced=0
ref_skipped=0

if [[ -d "$REF_DIR" ]]; then
  for ref_src in "$REF_DIR"/*.md; do
    [[ -f "$ref_src" ]] || continue
    ref_name=$(basename "$ref_src" .md)
    ref_target="${TARGET_DIR}/${ref_name}.md"

    if [[ ! -f "$ref_target" ]]; then
      ref_skipped=$((ref_skipped + 1))
      continue
    fi

    # 保留鏡像既有的 frontmatter（title / date / description / tags 是為 blog 讀者寫的）
    fm_end=$(awk 'NR>1 && /^---$/{print NR; exit}' "$ref_target")
    if [[ -z "$fm_end" ]]; then
      echo "  WARN: ${ref_target} 沒有可辨識的 frontmatter — 跳過" >&2
      ref_skipped=$((ref_skipped + 1))
      continue
    fi

    ref_tmp=$(mktemp)
    head -n "$fm_end" "$ref_target" > "$ref_tmp"
    echo "" >> "$ref_tmp"

    while IFS= read -r line; do
      # H1 → H2（與 SKILL.md 路徑一致）
      if [[ "$line" =~ ^'# '[^#] ]]; then
        line="#${line}"
      fi

      # 標了 broken-link-exempt 的行是示範用連結、不是真的指向某個檔，原樣輸出。
      # 少了這一段會對示範連結發假警告，而假警告會讓真警告被忽略。
      if echo "$line" | grep -q 'broken-link-exempt'; then
        echo "$line"
        continue
      fi

      # principles/xxx.md（含 ./ 前綴）→ /report/slug/
      if echo "$line" | grep -qE '(\./)?principles/'; then
        for slug in $(echo "$line" | grep -oE '(\./)?principles/[a-z0-9_-]+\.md' | sed 's|.*principles/||;s|\.md||'); do
          report_path=$(find_report_slug "$slug" 2>/dev/null) || true
          if [[ -n "$report_path" ]]; then
            line="${line//.\/principles\/${slug}.md/${report_path}}"
            line="${line//principles\/${slug}.md/${report_path}}"
          else
            echo "  WARN: ${ref_name} 引用的 ${slug} 沒有對應 report 卡 — 原樣保留" >&2
          fi
        done
      fi

      # 平輩 reference（含 ./ 前綴與 #anchor）→ /skills/<name>/xxx/
      if echo "$line" | grep -qE '\]\((\./)?[a-z0-9_-]+\.md(#[^)]*)?\)'; then
        for sib in $(echo "$line" | grep -oE '\]\((\./)?[a-z0-9_-]+\.md' | sed 's|.*(||;s|\./||;s|\.md||'); do
          if [[ -f "${TARGET_DIR}/${sib}.md" ]]; then
            # 取代字串不跳脫斜線——${var//pattern/replacement} 只有 pattern 那半
            # 需要跳脫，replacement 裡的 \/ 會被原樣輸出成字面反斜線。
            line="${line//](.\/${sib}.md/](/skills/${SKILL_NAME}/${sib}/}"
            line="${line//](${sib}.md/](/skills/${SKILL_NAME}/${sib}/}"
          else
            echo "  WARN: ${ref_name} 引用的平輩 ${sib} 沒有鏡像 — 原樣保留" >&2
          fi
        done
      fi

      echo "$line"
    done < "$ref_src" >> "$ref_tmp"

    mv "$ref_tmp" "$ref_target"
    ref_synced=$((ref_synced + 1))
  done

  if command -v ./bin/mdtools &>/dev/null && [[ $ref_synced -gt 0 ]]; then
    ./bin/mdtools fmt --fix "$TARGET_DIR" >/dev/null 2>&1 || true
  fi
  echo "  references: ${ref_synced} 份同步、${ref_skipped} 份無鏡像（略過）"
fi

lines=$(wc -l < "$TARGET" | tr -d ' ')
# 只數真的連結。裸寫在反引號裡的目錄名（散文提及那個路徑）不是待解析的連結，
# 把它算進來會產生一個永遠不會消失的警告，而長期存在的假警告會讓真警告被忽略。
# grep -c 在零命中時「既輸出 0 又回傳非零」，配上 `|| echo 0` 會得到兩個 0、
# 讓後面的算術比較炸掉。改用 `|| true` 讓 grep 自己輸出的 0 留下就好。
remaining=$(grep -cE '\]\([^)]*references/principles/[a-z0-9_-]+\.md' "$TARGET" 2>/dev/null || true)
remaining=${remaining:-0}

echo "Done. ${lines} lines written."
[[ "$remaining" -gt 0 ]] && echo "  WARN: ${remaining} unresolved references/principles/ links remain"
[[ "$remaining" -eq 0 ]] && echo "  All principle links resolved to /report/"
echo ""
echo "Next steps:"
echo "  git add $TARGET_DIR"
echo "  git commit --no-verify -m 'fix: ${TARGET_DIR} mirror sync v${skill_version}'"
