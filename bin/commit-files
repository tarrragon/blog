#!/usr/bin/env python3
"""只提交列出的檔案，不碰共用 git index 裡別人 staged 的東西。

用途：AGENTS.md〈提交〉。多個 session（或多個 agent）共用同一個 repo 時，共用 index 裡
可能有別人 staged 的檔案，直接 `git commit` 會把它們一起提交；對方正在跑 git 時，
`git add` 會因為 index.lock 而失敗。

用法：bin/commit-files -F <訊息檔> <檔案...>
  檔案寫從 repo 根目錄起算的路徑，列檔案不列目錄；刪除的檔案與改名的新舊兩個路徑都列。

行為：
1. 用一份私有 index（暫存目錄裡）提交：`git read-tree HEAD` 初始化，`git add -A -- <檔案>`，
   pre-commit hook 照常執行（hook 裡的 `git add` 也落在這份私有 index）。
2. 提交前比對 staged 清單（`--no-renames`，改名列出新舊兩個路徑）與給的清單，不一致就
   不提交、exit 1，並印出是哪一種：清單裡有目錄、檔案內容跟 HEAD 相同、或多出清單以外的檔案。
3. 提交後讓共用 index 對齊 HEAD：已經跟 HEAD 相同就不動；這幾個檔案只剩提交前的版本時
   （`git diff --cached --name-only <commit>~1 -- <檔案>` 是空的），跑 `git reset -q -- <檔案>`。
   共用 index 被鎖住、或別人也 staged 了同一個檔案（那條 diff 有輸出）時不 reset，
   印出 `[FOLLOW-UP]` 與之後要跑的指令，exit 3；reset 會清掉別人的 staging。

私有 index 隔離的是 staging，不隔離工作樹：兩個 session 改了同一個檔案時，對方在工作樹裡
的修改會一起提交。這支工具看不到誰改了哪一段，所以執行前的 diff 對照留在規則裡。

為什麼一律走私有 index：舊的程序先檢查共用 index 與 lock，乾淨就走一般 commit，否則改走
私有 index，兩條路徑各有自己的漏洞（`export GIT_INDEX_FILE` 在 agent 的 Bash 工具裡不會帶到
下一次呼叫、改名讓 staged 清單比對失敗）。只留一條路徑，測試涵蓋得到全部情形。

exit：0 提交完成且共用 index 已對齊；1 沒有提交（清單不一致或 commit 失敗）；
2 用法錯誤；3 已經提交，但共用 index 要之後處理（照 `[FOLLOW-UP]` 那幾行做）。

測試：python3 -m unittest discover -s bin/tests
"""

import argparse
import os
import shutil
import subprocess
import sys
import tempfile


def run(args, env=None, check=False):
    return subprocess.run(args, capture_output=True, text=True, env=env)


def die(msg, code):
    sys.stderr.write(f"commit-files: {msg}\n")
    sys.exit(code)


def main():
    ap = argparse.ArgumentParser(description="只提交列出的檔案，經由私有 index")
    ap.add_argument("-F", dest="msgfile", required=True)
    ap.add_argument("paths", nargs="+")
    args = ap.parse_args()

    top = run(["git", "rev-parse", "--show-toplevel"])
    if top.returncode != 0:
        die("不在 git repo 裡", 2)
    root = top.stdout.strip()
    msgfile = os.path.abspath(args.msgfile)
    if not os.path.isfile(msgfile):
        die(f"訊息檔不存在：{args.msgfile}", 2)
    os.chdir(root)

    dirs = [p for p in args.paths if os.path.isdir(p)]
    if dirs:
        die("清單裡有目錄（列檔案，不列目錄）：" + " ".join(dirs), 1)

    tmp = tempfile.mkdtemp(prefix="commit-files-")
    env = dict(os.environ, GIT_INDEX_FILE=os.path.join(tmp, "index"))
    try:
        r = run(["git", "read-tree", "HEAD"], env)
        if r.returncode != 0:
            die("git read-tree HEAD 失敗：" + r.stderr.strip(), 1)
        r = run(["git", "add", "-A", "--", *args.paths], env)
        if r.returncode != 0:
            die("git add 失敗：" + r.stderr.strip(), 1)
        staged = set(run(["git", "diff", "--cached", "--name-only", "--no-renames"], env).stdout.split("\n")) - {""}
        expected = set(args.paths)
        missing = sorted(expected - staged)
        extra = sorted(staged - expected)
        if missing or extra:
            if missing:
                sys.stderr.write(
                    "commit-files: 這些檔案沒有出現在 staged 清單（內容跟 HEAD 相同，或路徑不是從 repo 根目錄起算）：\n"
                    + "".join(f"  {p}\n" for p in missing)
                )
            if extra:
                sys.stderr.write("commit-files: staged 清單多出這些檔案：\n" + "".join(f"  {p}\n" for p in extra))
            die("沒有提交", 1)
        r = subprocess.run(["git", "commit", "-q", "-F", msgfile], env=env)
        if r.returncode != 0:
            die("git commit 失敗（讀上面的 hook 訊息修正；不用 --no-verify）", 1)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    sha = run(["git", "rev-parse", "HEAD"]).stdout.strip()
    print(f"commit-files: committed {sha[:8]}")

    lock = run(["git", "rev-parse", "--git-path", "index.lock"]).stdout.strip()
    paths = " ".join(args.paths)
    check_cmd = f"git diff --cached --name-only {sha[:8]}~1 -- {paths}"
    reset_cmd = f"git reset -q -- {paths}"
    if os.path.exists(lock):
        print("[FOLLOW-UP] 共用 index 被鎖住，還沒對齊 HEAD。lock 釋放之後跑：")
        print(f"  {check_cmd}")
        print(f"  輸出是空的就跑：{reset_cmd}；有輸出就不 reset（別人也 staged 了那幾個檔案）")
        sys.exit(3)
    if not run(["git", "diff", "--cached", "--name-only", "HEAD", "--", *args.paths]).stdout.strip():
        print("commit-files: shared index already matches HEAD")  # 例如這幾個檔案是用 git mv 或 git add 先 staged 的
        return
    others = run(["git", "diff", "--cached", "--name-only", f"{sha}~1", "--", *args.paths]).stdout.split()
    if others:
        print("[FOLLOW-UP] 共用 index 裡別人也 staged 了這些檔案，沒有 reset（reset 會清掉對方的 staging）：")
        print("".join(f"  {p}\n" for p in others), end="")
        sys.exit(3)
    r = run(["git", "reset", "-q", "--", *args.paths])
    if r.returncode != 0:
        print("[FOLLOW-UP] git reset 失敗：" + r.stderr.strip())
        print(f"  之後跑：{check_cmd}，空的就跑 {reset_cmd}")
        sys.exit(3)
    print("commit-files: shared index aligned with HEAD")


if __name__ == "__main__":
    main()
